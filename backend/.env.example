# =============================================================================
# HIMS ENVIRONMENT VARIABLES (TEMPLATE - SAFE FOR REPOSITORY)
# Copy this file to .env and replace placeholder values with your real credentials.
# NEVER COMMIT YOUR .env FILE TO VERSION CONTROL.
# =============================================================================

PROJECT_NAME=HIMS - Hospital Information Management System
VERSION=2.0.0
API_V1_STR=/api/v1
ENVIRONMENT=development

# Security & Authentication (Generate a 64-char random string in production)
SECRET_KEY=dev-hims-secret-key-change-in-production-1234567890abcdef
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
SESSION_COOKIE_NAME=hims_session
SESSION_COOKIE_MAX_AGE_DAYS=30

# Database (Neon PostgreSQL, Render Postgres, or SQLite for local testing)
DATABASE_URL=postgresql+psycopg://user:password@host/dbname?sslmode=require

# CORS Allowed Origins (include local dev URLs and production Vercel frontend URL)
FRONTEND_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","https://your-app.vercel.app"]

# One-Time Password (OTP) Configuration
OTP_EXPIRE_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# Email Delivery Provider (antideploy, resend, smtp, or mock)
EMAIL_PROVIDER=antideploy
RESEND_API_KEY=your_resend_or_antideploy_api_key_here
RESEND_BASE_URL=https://antideploy.com/api/resend
RESEND_API_URL=https://antideploy.com/api/resend
EMAIL_FROM=aura-hims <no-reply@your-domain.com>

# Optional SMTP Settings (if EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@hims-health.org

# Filebase S3-Compatible Storage (for consultation reports & clinical PDFs)
FILEBASE_ENDPOINT_URL=https://s3.filebase.io
FILEBASE_REGION=auto
FILEBASE_BUCKET_NAME=aura-hims-documents
FILEBASE_ACCESS_KEY_ID=your_filebase_access_key_here
FILEBASE_SECRET_ACCESS_KEY=your_filebase_secret_key_here
